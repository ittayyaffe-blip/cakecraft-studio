# Copy to .env for local development and fill in real values.
# On Railway, set these as service environment variables instead —
# do not commit real secrets.

# Required — Supabase project credentials.
SUPABASE_URL=
SUPABASE_KEY=

# Optional — overrides the default dev-only CORS regex (localhost,
# 127.0.0.1, 192.168.x.x). Set this on Railway once the production
# frontend's origin is known, e.g.:
# CORS_ALLOW_ORIGIN_REGEX=^https://(www\.)?your-frontend-domain\.com$
CORS_ALLOW_ORIGIN_REGEX=
