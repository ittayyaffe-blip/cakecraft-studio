# Copy to .env for local development and fill in real values.
# On Railway, set these as service environment variables instead —
# do not commit real secrets.

# Required — Supabase project credentials.
SUPABASE_URL=
SUPABASE_KEY=

# Optional — admin auth (backend/app/services/auth_service.py). Reuses
# SUPABASE_URL/SUPABASE_KEY above (same project's Supabase Auth) — no
# separate credentials needed. Controls what an admin logout revokes:
# "global" (every session/device for that user), "local" (just this one),
# or "others" (every session except this one). Defaults to "global".
ADMIN_SIGNOUT_SCOPE=

# Optional — Gmail adapter (backend/app/services/communication/gmail_adapter.py).
# Both unset means the notification engine's Send action still works, it
# just doesn't actually deliver anything (the same "not configured" fallback
# every AI/integration feature in this project already uses). GMAIL_APP_PASSWORD
# is a Gmail *app password* (Google Account > Security > App passwords),
# never the account's real login password — set both on Railway as service
# env vars, never commit real values here.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional — WhatsApp adapter (backend/app/services/communication/whatsapp_adapter.py).
# Both unset means the same clean "not configured" fallback as Gmail above.
# whatsapp_access_token is a Meta system-user or temporary access token for
# the WhatsApp Business app; whatsapp_phone_number_id is the Cloud API
# phone number ID (not the phone number itself) the business sends from.
# Set both on Railway as service env vars, never commit real values here.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional — Business Intelligence Layer: RAG answer generation
# (backend/app/services/rag_service.py) and the AI Operations Agent
# (backend/app/services/agent_service.py). Unset means both report
# themselves as not configured and degrade to a clear message instead of
# a crash — same contract as the Gmail/WhatsApp settings above.
# Get a key at https://console.anthropic.com/settings/keys — set it on
# Railway as a service env var, never commit a real value here.
ANTHROPIC_API_KEY=
